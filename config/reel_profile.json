{
  "version": 1,
  "profile": "shunri-reel-v1",
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "container": "mp4",
    "videoCodec": "h264",
    "audioCodec": "aac"
  },
  "voice": {
    "id": "shunri",
    "canonicalReference": "~/shunri-voice/references/shunri.wav",
    "preset": "clone",
    "fallbackVoiceDesign": false
  },
  "sceneTypes": [
    "talk",
    "talk_overlay",
    "broll",
    "emphasis",
    "cta"
  ],
  "captions": {
    "rendererOwned": true,
    "maxLines": 2,
    "avoidTextInsideGeneratedImages": true,
    "wordTimestampAlignment": "whisper-fallback",
    "duplicateSubtitlePolicy": "reject",
    "currentAlignment": "speech-energy-pauses-v1",
    "alignmentRoadmap": [
      "word-timestamps-when-provider-available",
      "speech-energy-pauses-v1",
      "character-weight-fallback"
    ],
    "engine": "japanese-semantic-v2",
    "maxLineChars": 18,
    "maxCueChars": 30,
    "avoidOrphanLine": true,
    "avoidBrokenExpressions": true,
    "keywordEmphasis": "color-pop-v1",
    "emphasisMode": "color-pop-v1",
    "entryAnimation": "fade-up-v1",
    "accentHex": "#FF7A00",
    "accentAss": "&H00007AFF&"
  },
  "pacing": {
    "defaultVisualChangeSeconds": [
      2,
      5
    ],
    "insertSeconds": [
      1,
      3
    ],
    "emphasisSeconds": [
      0.6,
      2
    ],
    "cameraMotionCycle": [
      "slow-push",
      "punch-in",
      "drift-left",
      "punch-in",
      "drift-right",
      "micro-drift",
      "cta-push"
    ]
  },
  "transitions": {
    "default": "cut",
    "allowed": [
      "cut",
      "subtle-push-in",
      "punch-in",
      "crossfade"
    ],
    "decorativeTransitions": false
  },
  "presenter": {
    "strategy": "motion-bank-first",
    "requiredVariants": [
      "neutral-talk",
      "open-hand",
      "point-up",
      "point-side",
      "think",
      "small-nod",
      "explain-both-hands",
      "cta-forward"
    ]
  },
  "visuals": {
    "priority": [
      "real-shunlp-demo-screenshot",
      "approved-brand-asset",
      "generated-diagram",
      "generated-broll"
    ],
    "randomStockFallback": false,
    "sceneOverlayNaming": "s01.png|jpg|jpeg|webp",
    "overlayAnimation": "top-slide-fade-v1",
    "overlayTop": 120,
    "layoutVariants": [
      "center",
      "left-presenter",
      "right-presenter",
      "fullscreen-card"
    ],
    "calloutMode": "mixed-overlay-v1",
    "presenterSideInset": 40,
    "fullscreenCardInset": 55
  },
  "audio": {
    "narrationIsMaster": true,
    "bgmAutoDuck": true,
    "repetitiveWhoosh": false,
    "bgmOptional": true,
    "autoOriginalBgm": false,
    "autoSparseSfx": false,
    "sfxPolicy": [
      "asset-bank-only"
    ],
    "productionPolicy": "asset-only",
    "syntheticAudioAllowed": false,
    "defaultWithoutAssets": "narration-only",
    "finalLoudnessLUFS": -16,
    "truePeakDbTP": -1.5,
    "externalBgmVolume": 0.12
  },
  "qa": {
    "rejectOn": [
      "missing-narration",
      "wrong-voice",
      "subtitle-narration-mismatch",
      "duplicate-subtitles",
      "unsafe-text-position",
      "clipped-audio",
      "broken-media",
      "wrong-aspect-ratio",
      "wrong-shunri-identity",
      "approved-script-mutated",
      "caption-more-than-2-lines",
      "caption-orphan-line",
      "caption-kinsoku-start",
      "caption-broken-expression",
      "video-decode-failed",
      "caption-unbalanced-ass-tags",
      "caption-invalid-ass-tag",
      "caption-missing-entry-animation",
      "caption-broken-emphasis-animation",
      "caption-missing-pop-scale",
      "invalid-layout-variant"
    ],
    "report": "qa-report.json"
  }
}
